# mqvpn client configuration
# Copy to /etc/mqvpn/client-<name>.conf and edit as needed.
# Start with: systemctl start mqvpn-client@<name>

[Server]
Address = your-server.example.com:443
# Insecure = false

[Auth]
Key = <YOUR_PSK_HERE>

[Interface]
TunName = mqvpn0
DNS = 1.1.1.1, 8.8.8.8
LogLevel = info
# TUN MTU (1280–9000, default: auto = ~1382)
# MTU = 1280
# also stops interface-bound apps (e.g. Tailscale on Windows) from bypassing the tunnel
# KillSwitch = false
# set to false on router/embedded integrations to keep host routes untouched
# ManageRoutes = true
# Reconnect = true
# ReconnectInterval = 5

[Multipath]
Scheduler = wlb
# Override the server's scheduler with Scheduler above for this client's downloads
# (needs AllowClientScheduler = true on the server):
# RequestServerScheduler = true
# Congestion control (bbr2|bbr|cubic|none)
# CC = bbr2
# Path = eth0
# Path = wlan0
